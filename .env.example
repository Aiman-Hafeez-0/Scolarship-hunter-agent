# Copy this file to .env and fill in the values. Never commit .env.

# Supabase > your project > Connect > Session pooler URI (replace [YOUR-PASSWORD])
DATABASE_URL=
# Your email; shown in the bot's User-Agent so site owners can contact you
CONTACT_EMAIL=
# Google AI Studio > Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq Console > API Keys (https://console.groq.com/keys) - fallback LLM
GROQ_API_KEY=
# The Gmail address that sends the digest emails
GMAIL_ADDRESS=
# Google Account > Security > 2-Step Verification > App passwords (16 characters)
GMAIL_APP_PASSWORD=
# Where digests, reminders and error alerts are sent
ADMIN_EMAIL=
