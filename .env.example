# Copy this file to .env and fill in the values. Never commit .env.

# Supabase > your project > Connect > Session pooler URI (replace [YOUR-PASSWORD])
DATABASE_URL=
# Your email; shown in the bot's User-Agent so site owners can contact you
CONTACT_EMAIL=
# Google AI Studio > Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq Console > API Keys (https://console.groq.com/keys) - fallback LLM
GROQ_API_KEY=
# How emails are sent: resend (default) or gmail
MAIL_PROVIDER=
# resend.com > API Keys (free account: sends only to the email you signed up with)
RESEND_API_KEY=
# Only for MAIL_PROVIDER=gmail: the Gmail address that sends the emails
GMAIL_ADDRESS=
# Google Account > Security > 2-Step Verification > App passwords (16 characters)
GMAIL_APP_PASSWORD=
# Where digests, reminders and error alerts are sent
ADMIN_EMAIL=
# LLM tokens per month; an admin alert is sent above 80% (blank = 1000000, 0 = no alert)
MONTHLY_TOKEN_BUDGET=
# Dashboard login email (the profile with this email is the one shown on the dashboard)
DASHBOARD_EMAIL=
# Run `uv run python -m app.hash_password` and paste the line it prints
DASHBOARD_PASSWORD_HASH=
# Random text that signs the login cookie; the hash_password command prints one for you
SESSION_SECRET=
# Dashboard "Run now" button: GitHub > Settings > Developer settings > Fine-grained tokens,
# only this repository, permission "Actions: Read and write". Never share it.
RUN_NOW_GITHUB_TOKEN=
# The repository as owner/name, e.g. someone/scholarship-hunter
RUN_NOW_GITHUB_REPO=
# Branch whose weekly.yml "Run now" starts. Leave commented out to use main.
# RUN_NOW_GITHUB_REF=
